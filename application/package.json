{
  "name": "cognicare-application",
  "version": "1.0.0",
  "description": "CogniCare CDTx Native Mobile & Tablet Application for MDoNER Elderly Dementia Care",
  "private": true,
  "scripts": {
    "sync": "bash scripts/sync-frontend.sh",
    "cap:sync": "cap sync",
    "cap:open": "CAPACITOR_ANDROID_STUDIO_PATH=/opt/android-studio/bin/studio.sh cap open android",
    "cap:copy": "cap copy",
    "build:apk": "bash scripts/build-apk.sh",
    "dev": "cap run android -l --external"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.0.0",
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.1",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/screen-orientation": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "typescript": "^5.7.0"
  }
}
